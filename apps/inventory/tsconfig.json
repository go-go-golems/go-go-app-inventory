{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "outDir": "dist",
    "skipLibCheck": true,
    "paths": {
      "@go-go-golems/os-shell": ["../../../go-go-os-frontend/packages/desktop-os/src"],
      "@go-go-golems/os-shell/*": ["../../../go-go-os-frontend/packages/desktop-os/src/*"],
      "@go-go-golems/os-core": ["../../../go-go-os-frontend/packages/engine/src"],
      "@go-go-golems/os-core/*": ["../../../go-go-os-frontend/packages/engine/src/*"],
      "@go-go-golems/os-chat": ["../../../go-go-os-frontend/packages/chat-runtime/src"],
      "@go-go-golems/os-chat/*": ["../../../go-go-os-frontend/packages/chat-runtime/src/*"],
      "@go-go-golems/os-scripting": ["../../../go-go-os-frontend/packages/hypercard-runtime/src"],
      "@go-go-golems/os-scripting/*": ["../../../go-go-os-frontend/packages/hypercard-runtime/src/*"],
      "@go-go-golems/os-kanban": ["../../../go-go-os-frontend/packages/kanban-runtime/src"],
      "@go-go-golems/os-kanban/*": ["../../../go-go-os-frontend/packages/kanban-runtime/src/*"],
      "@go-go-golems/os-ui-cards": ["../../../go-go-os-frontend/packages/ui-runtime/src"],
      "@go-go-golems/os-ui-cards/*": ["../../../go-go-os-frontend/packages/ui-runtime/src/*"],
      "@go-go-golems/os-confirm": ["../../../go-go-os-frontend/packages/confirm-runtime/src"],
      "@go-go-golems/os-confirm/*": ["../../../go-go-os-frontend/packages/confirm-runtime/src/*"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../../go-go-os-frontend/packages/desktop-os" },
    { "path": "../../../go-go-os-frontend/packages/engine" },
    { "path": "../../../go-go-os-frontend/packages/chat-runtime" },
    { "path": "../../../go-go-os-frontend/packages/hypercard-runtime" },
    { "path": "../../../go-go-os-frontend/packages/kanban-runtime" },
    { "path": "../../../go-go-os-frontend/packages/ui-runtime" },
    { "path": "../../../go-go-os-frontend/packages/confirm-runtime" }
  ]
}
